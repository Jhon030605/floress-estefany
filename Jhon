<!-- =========================================
     JAVASCRIPT
========================================= -->

<script>


/* =========================================
   REFERENCIAS
========================================= */

const envelope =
    document.getElementById("envelope");

const envelopeScreen =
    document.getElementById("envelopeScreen");

const mainScreen =
    document.getElementById("mainScreen");

const surprise =
    document.getElementById("surprise");

const surpriseBtn =
    document.getElementById("surpriseBtn");



/* =========================================
   ABRIR SOBRE
========================================= */

envelope.addEventListener("click", () => {

    envelope.classList.add("open");

    setTimeout(() => {

        envelopeScreen.classList.add("hidden");

        mainScreen.classList.remove("hidden");

        startFlowers();

    }, 900);

});



/* =========================================
   ESTRELLAS
========================================= */

const stars =
    document.getElementById("stars");

for (let i = 0; i < 60; i++) {

    const s =
        document.createElement("span");

    s.className = "star";

    s.style.left =
        Math.random() * 100 + "%";

    s.style.top =
        Math.random() * 65 + "%";

    s.style.animationDelay =
        Math.random() * 2 + "s";

    stars.appendChild(s);

}



/* =========================================
   HOJAS Y CORAZONES
========================================= */

function drop() {

    const p =
        document.createElement("div");

    p.className = "fall";


    p.textContent =
        Math.random() > .35
            ? "🍂"
            : "💛";


    p.style.left =
        Math.random() * 100 + "%";


    p.style.fontSize =
        16 + Math.random() * 17 + "px";


    p.style.animationDuration =
        5 + Math.random() * 5 + "s";


    mainScreen.appendChild(p);


    setTimeout(() => {

        p.remove();

    }, 11000);

}



/* =========================================
   INICIAR EFECTOS
========================================= */

let flowersStarted = false;

function startFlowers() {

    if (flowersStarted) return;

    flowersStarted = true;

    setInterval(drop, 550);

}



/* =========================================
   ABRIR SORPRESA
========================================= */

surpriseBtn.addEventListener("click", () => {

    surprise.classList.add("show");


    for (let i = 0; i < 20; i++) {

        setTimeout(drop, i * 70);

    }

});



/* =========================================
   CERRAR SORPRESA
========================================= */

document
    .getElementById("closeSurprise")
    .addEventListener("click", () => {

        surprise.classList.remove("show");

    });


